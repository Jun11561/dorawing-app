rules_version = '2';

// 두로잉 보호자 연결 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 그대로 붙여 넣고 게시한다
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isGuardianOf(elderUid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/elders/$(elderUid)).data.guardians;
    }

    // 어르신 문서: 보호자 uid 목록(최대 2명)과 만든 시각만
    function validElder(data) {
      return data.keys().hasOnly(['guardians', 'createdAt'])
        && data.guardians is list
        && data.guardians.size() <= 2;
    }

    // 보호자는 목록에서 자기 자신만 뺄 수 있다
    function leavingSelf() {
      return signedIn()
        && request.auth.uid in resource.data.guardians
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardians'])
        && request.resource.data.guardians == resource.data.guardians.removeAll([request.auth.uid]);
    }

    // 연결 요청: 이 어르신의 코드가 있고, 안 쓰였고, 시간이 안 지났을 때만
    function validRequest(elderUid) {
      let data = request.resource.data;
      let pair = get(/databases/$(database)/documents/pairCodes/$(data.code)).data;
      return data.keys().hasOnly(['name', 'code', 'requestedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 20
        && data.code is string && data.code.matches('[0-9]{6}')
        && data.requestedAt == request.time
        && pair.elderUid == elderUid
        && pair.used == false
        && pair.expiresAt > request.time;
    }

    // 요약: 공유하기로 한 칸만 (앱의 Summary.KEYS와 같아야 한다)
    function validSummary() {
      return request.resource.data.keys().hasOnly(['day', 'updatedAt', 'diagnosis', 'areas', 'attendDays', 'lastPlayedAt', 'alerts']);
    }

    // 연결 코드: 6자리, 10분 안에 끝나는 것만
    function validCode(code) {
      return code.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['elderUid', 'expiresAt', 'used'])
        && request.resource.data.elderUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(11, 'm');
    }

    match /elders/{elderUid} {
      // 읽기: 본인과 연결된 보호자만
      allow get: if isMe(elderUid) || (signedIn() && request.auth.uid in resource.data.guardians);
      allow list: if false;
      // 쓰기: 본인만. 보호자는 자기 자신을 빼는 것만
      allow create: if isMe(elderUid) && validElder(request.resource.data);
      allow update: if (isMe(elderUid) && validElder(request.resource.data)) || leavingSelf();
      allow delete: if isMe(elderUid);

      match /requests/{guardianUid} {
        allow read, delete: if isMe(elderUid);
        allow create, update: if isMe(guardianUid) && validRequest(elderUid);
      }

      match /summaries/{day} {
        allow read: if isMe(elderUid) || isGuardianOf(elderUid);
        allow create, update: if isMe(elderUid) && validSummary();
        allow delete: if isMe(elderUid);
      }
    }

    match /pairCodes/{code} {
      // 로그인한 사용자는 코드 하나를 직접 조회만. 목록 조회는 막는다
      allow get: if signedIn();
      allow list: if false;
      // 만들기와 사용 처리는 그 코드를 만든 어르신만
      allow create: if signedIn() && validCode(code) && request.resource.data.used == false;
      allow update: if signedIn() && resource.data.elderUid == request.auth.uid && validCode(code);
      allow delete: if signedIn() && resource.data.elderUid == request.auth.uid;
    }
  }
}
