<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Dorawing" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/coral_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- 따로 지정하지 않은 글자와 버튼도 어르신용 크기로 -->
        <item name="android:textViewStyle">@style/Text.Body</item>
        <item name="materialButtonStyle">@style/Button.Primary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Dorawing.Dialog</item>
    </style>

    <!-- 확인 창도 큰 글씨로 -->
    <style name="ThemeOverlay.Dorawing.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog.Button</item>
        <!-- 계속하기를 꽉 찬 버튼으로 해서 그만하기와 헷갈리지 않게 -->
        <item name="buttonBarNegativeButtonStyle">@style/Dialog.Button.Keep</item>
    </style>

    <style name="Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <style name="Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="Dialog.Button.Keep" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner</item>
        <item name="backgroundTint">@color/green_dark</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 작은 글자 버튼 (배경 없음). 크기는 어르신용 기준을 지킨다 -->
    <style name="Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
    </style>

    <!-- 글자. 한국어가 단어 중간에서 줄이 바뀌지 않게 phrase (Android 13부터) -->
    <style name="Text.Body" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Title" parent="Text.Body">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/green_dark</item>
    </style>

    <style name="Text.Sub" parent="Text.Body">
        <item name="android:textColor">@color/text_sub</item>
    </style>

    <!-- 큰 버튼 3종 -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/corner</item>
        <item name="backgroundTint">@color/green_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">@dimen/icon_size</item>
    </style>

    <!-- 흰 글자와 대비를 맞추려고 진한 코랄을 쓴다 -->
    <style name="Button.Accent" parent="Button.Primary">
        <item name="backgroundTint">@color/coral_dark</item>
    </style>

    <style name="Button.Secondary" parent="Button.Primary">
        <item name="backgroundTint">@color/green_light</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="iconTint">@color/green_dark</item>
        <item name="strokeColor">@color/green_mid</item>
        <item name="strokeWidth">@dimen/button_stroke</item>
    </style>

    <!-- 카드 -->
    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/green_light</item>
        <item name="cardCornerRadius">@dimen/corner</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>
</resources>
