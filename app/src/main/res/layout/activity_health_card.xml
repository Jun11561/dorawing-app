<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <!-- 글자를 키운 폰에서도 카드가 덜 잘리게 버튼까지 함께 스크롤 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 그림 자리: 카드마다 아이콘과 종류 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_picture"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="@dimen/gap">

                        <ImageView
                            android:id="@+id/ivIcon"
                            android:layout_width="@dimen/card_icon"
                            android:layout_height="@dimen/card_icon"
                            android:layout_marginEnd="@dimen/gap"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvPicture"
                            style="@style/Text.Heading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- 카드 제목: 이 화면에서 가장 큰 글자 -->
                    <TextView
                        android:id="@+id/tvCardTitle"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/card_gap" />

                    <TextView
                        android:id="@+id/tvBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 전화번호가 있는 카드(콜센터)만. 다음이 꽉 찬 버튼이라 테두리 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:text="@string/card_call"
                android:visibility="gone"
                app:icon="@drawable/ic_card_call"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/card_more" />

            <TextView
                android:id="@+id/tvMoreHelp"
                style="@style/Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/card_more_help" />

            <!-- 빈 공간 없이 카드 묶음 바로 아래 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:text="@string/card_next" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
