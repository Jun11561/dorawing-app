<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/card_gap">

            <!-- 다시 설치해서 연결이 끊겼을 때 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReinstall"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/row_icon"
                        android:layout_height="@dimen/row_icon"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="@dimen/gap"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        app:tint="@color/error_brown" />

                    <TextView
                        style="@style/Text.Error"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/code_reinstall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 준비 중, 인터넷 없음 -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/guardian_retry"
                android:visibility="gone" />

            <!-- 연결 번호: 이 화면에서 가장 큰 글자 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCode"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:visibility="gone"
                app:strokeColor="@color/green_dark"
                app:strokeWidth="@dimen/button_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/code_guide"
                        android:textColor="@color/text_main" />

                    <TextView
                        android:id="@+id/tvCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap"
                        android:background="@drawable/bg_card_picture"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingTop="@dimen/gap"
                        android:paddingBottom="@dimen/gap"
                        android:textColor="@color/green_dark"
                        android:textSize="@dimen/code_text"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTimer"
                        style="@style/Text.Sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center" />

                    <!-- 시간이 지났거나 쓰였을 때는 이것이 할 일 하나 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap"
                        android:text="@string/code_new"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:text="@string/code_full"
                android:visibility="gone" />

            <!-- 연결된 보호자 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGuardians"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/code_guardians_title" />

                    <TextView
                        android:id="@+id/tvNoGuardian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/code_no_guardian" />

                    <!-- 보호자마다 이름과 연결 끊기 버튼을 코드에서 넣는다 -->
                    <LinearLayout
                        android:id="@+id/guardianList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:text="@string/code_reinstall_hint" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
