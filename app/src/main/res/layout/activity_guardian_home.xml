<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 연결 안 됨, 끊김, 기록 없음, 인터넷 없음 -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnterCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/ghome_enter_code"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/boxData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvUpdated"
                    style="@style/Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 변화 알림 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlert"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/pink_light">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ghome_alert_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAlertAreas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap" />

                        <TextView
                            style="@style/Text.Sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap"
                            android:text="@string/ghome_alert_note" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 영역별 정답률과 단계 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_chart_title"
                            android:textColor="@color/green_dark"
                            android:textSize="@dimen/text_button"
                            android:textStyle="bold" />

                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/chart"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_marginTop="@dimen/gap" />

                        <TextView
                            android:id="@+id/tvLevels"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap" />

                        <TextView
                            android:id="@+id/tvNoSets"
                            style="@style/Text.Sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 출석과 마지막 훈련 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_week_title"
                            android:textColor="@color/green_dark"
                            android:textSize="@dimen/text_button"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWeek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap" />

                        <TextView
                            android:id="@+id/tvLastPlay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 마지막 자가진단 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_diag_title"
                            android:textColor="@color/green_dark"
                            android:textSize="@dimen/text_button"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiagDate"
                            style="@style/Text.Sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap" />

                        <TextView
                            android:id="@+id/tvDiag"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            style="@style/Text.Sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap"
                            android:text="@string/result_note" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:text="@string/ghome_refresh"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeave"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/ghome_leave"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnElderMode"
                style="@style/Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/ghome_elder_mode" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
