<?xml version="1.0" encoding="utf-8"?>
<!-- 게임 공통 틀. 가운데 gameArea에 게임마다의 레이아웃이 들어간다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <!-- 왼쪽 문제 유형, 오른쪽 몇 번째인지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKind"
            style="@style/Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvProgress"
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        app:indicatorColor="@color/green_mid"
        app:trackColor="@color/green_light"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <!-- 지금 할 일 한 줄 -->
    <TextView
        android:id="@+id/tvGuide"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap" />

    <!-- 게임 내용 -->
    <FrameLayout
        android:id="@+id/gameArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1" />

    <!-- 맞았는지, 정답이 무엇인지 -->
    <TextView
        android:id="@+id/tvFeedback"
        style="@style/Text.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:gravity="center"
        android:textColor="@color/text_main"
        android:visibility="gone" />

    <!-- 푸는 동안은 힌트, 틀린 뒤에는 다시 해 볼까요 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHint"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_hint"
            app:icon="@drawable/ic_info" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/game_retry"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
