<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <!-- 진행 막대, 비교 안내, 문항만 스크롤. 문항이 길 때만 스크롤 막대가 보인다 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <!-- 몇 번째 문항인지: 글자와 막대 -->
            <TextView
                android:id="@+id/tvProgress"
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:max="15"
                app:indicatorColor="@color/green_mid"
                app:trackColor="@color/green_light"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <!-- 모든 문항 위에 고정. 놓치지 않게 진하게 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/diag_compare"
                android:textColor="@color/green_dark"
                android:textStyle="bold" />

            <!-- 문항: 이 화면에서 가장 큰 글자 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:contentPaddingBottom="@dimen/gap"
                app:contentPaddingTop="@dimen/gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 답하지 않은 문항으로 왔을 때만 보임 -->
                    <TextView
                        android:id="@+id/tvNotice"
                        style="@style/Text.Error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/gap"
                        android:text="@string/diag_answer_please"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvQuestion"
                        style="@style/Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- 답 3개는 화면 아래에 고정. 문항이 길어도 늘 보인다 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer0"
        style="@style/Button.Choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/diag_answer_0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer1"
        style="@style/Button.Choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/diag_answer_1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer2"
        style="@style/Button.Choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/diag_answer_2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrev"
        style="@style/Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/diag_prev" />
</LinearLayout>
