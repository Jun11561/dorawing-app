<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <TextView
        android:id="@+id/tvProgress"
        style="@style/Text.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_title" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer0"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/diag_answer_0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer1"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/diag_answer_1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer2"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/diag_answer_2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_padding"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/button_height"
            android:text="@string/diag_prev"
            android:textColor="@color/green_dark"
            android:textSize="@dimen/text_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/button_height"
            android:text="@string/diag_listen"
            android:textColor="@color/green_dark"
            android:textSize="@dimen/text_button" />
    </LinearLayout>
</LinearLayout>
