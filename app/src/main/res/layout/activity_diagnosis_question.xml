<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/green_dark"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!-- 모든 문항 위에 고정 -->
    <TextView
        style="@style/Text.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diag_compare" />

    <!-- 답하지 않은 문항으로 왔을 때만 보임 -->
    <TextView
        android:id="@+id/tvNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/diag_answer_please"
        android:textColor="@color/green_dark"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gap"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_title" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer0"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_padding"
        android:text="@string/diag_answer_0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer1"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_padding"
        android:text="@string/diag_answer_1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer2"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_padding"
        android:text="@string/diag_answer_2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            style="@style/Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_prev" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            style="@style/Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/diag_listen" />
    </LinearLayout>
</LinearLayout>
