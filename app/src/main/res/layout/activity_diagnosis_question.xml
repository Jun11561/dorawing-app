<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- 제목 줄은 "1년 전과 비교해 주세요" -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <!-- 한 줄에 왼쪽 이전 문항, 오른쪽 몇 번째인지. 1번 문항에서는 이전 문항을 숨기고 자리는 둔다 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 누르는 영역 48dp -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="0dp"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/gap"
            android:paddingBottom="0dp"
            android:text="@string/diag_prev" />

        <TextView
            android:id="@+id/tvProgress"
            style="@style/Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:max="15"
        app:indicatorColor="@color/green_mid"
        app:trackColor="@color/green_light"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <!-- 문항만 스크롤. 길 때만 스크롤 막대와 아래쪽 흐림이 보인다 -->
    <com.team3.dorawing.util.FadeScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fadingEdgeLength="48dp"
        android:requiresFadingEdge="vertical">

        <!-- 문항: 이 화면에서 가장 큰 글자 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:layout_marginBottom="4dp"
            app:contentPaddingBottom="@dimen/gap"
            app:contentPaddingTop="@dimen/gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 답하지 않은 문항으로 왔을 때만 보임 -->
                <TextView
                    android:id="@+id/tvNotice"
                    style="@style/Text.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/gap"
                    android:text="@string/diag_answer_please"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvQuestion"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.team3.dorawing.util.FadeScrollView>

    <!-- 답 3개는 화면 아래에 고정. 문항이 길어도 늘 보인다 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer0"
        style="@style/Button.Choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/diag_answer_0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer1"
        style="@style/Button.Choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/diag_answer_1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnswer2"
        style="@style/Button.Choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/diag_answer_2" />
</LinearLayout>
