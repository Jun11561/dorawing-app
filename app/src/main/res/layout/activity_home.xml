<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- 인사말과 부제 "오늘의 기억을 그리다"는 상단 띠 안에 (HomeActivity) -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/card_gap">

            <!-- 매일 할 일 하나만 꽉 찬 버튼, 나머지는 테두리 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:text="@string/home_game" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiagnosis"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/home_diagnosis" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecord"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:text="@string/home_record" />

            <!-- 오늘의 건강 카드: 누르는 카드. 위에 테이프 장식 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHealth"
                    style="@style/Card.Clickable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/gap"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Text.Heading"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/home_cards" />

                                <TextView
                                    android:id="@+id/tvCardsStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/home_cards_todo" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/stampCards"
                                style="@style/Stamp"
                                android:text="@string/stamp_cards" />
                        </LinearLayout>

                        <!-- 누르는 카드라는 표시: 도장과 떨어진 아래 줄 오른쪽 -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/gap"
                            android:background="@color/line" />

                        <TextView
                            style="@style/Text.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/gap"
                            android:gravity="end"
                            android:text="@string/home_cards_open" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="72dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_tape"
                    android:elevation="4dp"
                    android:rotation="-4" />
            </FrameLayout>

            <!-- 오늘 출석: 정보만 보여 주는 카드 (화살표 없음) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/gap"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Heading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_attend_title" />

                        <TextView
                            android:id="@+id/tvAttend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/home_attend_todo" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/stampAttend"
                        style="@style/Stamp"
                        android:text="@string/stamp_attend" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 디버그 빌드에서만 보임 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDebug"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/screen_padding"
                android:text="@string/title_debug"
                android:textColor="@color/text_sub"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
