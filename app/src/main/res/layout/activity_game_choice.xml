<?xml version="1.0" encoding="utf-8"?>
<!-- 게임 보기 버튼 한 개. BaseGameActivity.addChoices가 코드에서 넣는다.
     한 줄에 두 개 놓일 때 큰 글씨에서 줄이 꺾이지 않게 한 줄로 두고 글자 크기를 칸에 맞춘다 (22sp에서 16sp까지) -->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Button.Choice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:maxLines="1"
    app:autoSizeMaxTextSize="@dimen/text_button"
    app:autoSizeMinTextSize="@dimen/game_choice_min_text"
    app:autoSizeTextType="uniform" />
