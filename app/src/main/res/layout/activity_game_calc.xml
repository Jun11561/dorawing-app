<?xml version="1.0" encoding="utf-8"?>
<!-- 계산력 게임. 위에 물건과 가격표, 가운데 질문, 아래에 보기 또는 돈 (BaseGameActivity의 gameArea 안에 들어간다) -->
<com.team3.dorawing.util.FadeScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fadeScrollbars="false"
    android:fadingEdgeLength="48dp"
    android:fillViewport="true"
    android:requiresFadingEdge="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 물건과 가격표. 질문은 위 안내 줄에 있어서 여기엔 다시 쓰지 않는다. 물건이 없는 문제에선 카드를 숨긴다 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/boxItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/listChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <!-- 돈 내기 -->
        <LinearLayout
            android:id="@+id/boxMoney"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPaid"
                style="@style/Text.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/rowBills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/rowCoins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    style="@style/Button.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/game_calc_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPay"
                    style="@style/Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap"
                    android:layout_weight="1"
                    android:text="@string/game_calc_pay_done" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.team3.dorawing.util.FadeScrollView>
